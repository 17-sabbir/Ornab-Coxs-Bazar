APP_NAME="Ornab Cox's Bazar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ornabcoxsbazar.org

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ornabcoxsbazar
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ornabcoxsbazar.org
MAIL_FROM_NAME="${APP_NAME}"

# Google reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Payment Gateways (Add real credentials in production)
PAYMENT_SSLCOMMERZ_ENABLED=false
PAYMENT_SSLCOMMERZ_STORE_ID=
PAYMENT_SSLCOMMERZ_STORE_PASSWORD=
PAYMENT_SSLCOMMERZ_SANDBOX=true

PAYMENT_SHURJOPAY_ENABLED=false
PAYMENT_SHURJOPAY_USERNAME=
PAYMENT_SHURJOPAY_PASSWORD=

PAYMENT_BKASH_ENABLED=false
PAYMENT_BKASH_APP_KEY=
PAYMENT_BKASH_APP_SECRET=

PAYMENT_NAGAD_ENABLED=false
PAYMENT_NAGAD_MERCHANT_ID=
PAYMENT_NAGAD_SECRET_KEY=

PAYMENT_ROCKET_ENABLED=false
PAYMENT_ROCKET_MERCHANT_ID=
PAYMENT_ROCKET_SECRET_KEY=

PAYMENT_STRIPE_ENABLED=false
PAYMENT_STRIPE_PUBLISHABLE_KEY=
PAYMENT_STRIPE_SECRET_KEY=
PAYMENT_STRIPE_WEBHOOK_SECRET=

PAYMENT_PAYPAL_ENABLED=false
PAYMENT_PAYPAL_CLIENT_ID=
PAYMENT_PAYPAL_CLIENT_SECRET=

# AWS (For file storage - optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1